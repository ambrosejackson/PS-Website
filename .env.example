# Website Supabase project (NEVER the PSM project)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Set in Vercel (Production + Preview, Sensitive) and .env.local by Ambrose. NEVER commit.
SUPABASE_SERVICE_ROLE_KEY=
# Feature flags
MOCK_PSM_DATA=true
STRIPE_ENABLED=false
# Comma-separated staff emails allowed into /admin
ADMIN_ALLOWED_EMAILS=ambrose@privatestock.co
# Bearer token for /api/revalidate (set a long random value in Vercel + .env.local)
REVALIDATE_TOKEN=
# Canonical site URL for metadata/sitemap
NEXT_PUBLIC_SITE_URL=https://privatestock.co

# Resend transactional email (D-042). Unset = send() no-ops with a console.warn.
RESEND_API_KEY=

# iHeartJane master sheet (link-accessible; default is the PS PCT workbook)
IHEARTJANE_SHEET_ID=1vYYvhaWUPfqAe1NmKihdxNeBs-AizutQG0Bbnoyffao
# Vercel cron auth for /api/cron/* (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ---- Merch commerce (D-039). Test/sandbox keys on preview, live on production.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From Stripe Dashboard → Developers → Webhooks → endpoint /api/stripe/webhook → Signing secret
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) | live
PAYPAL_ENV=sandbox

# Bearer secret the PSM publish job presents to POST /api/psm/publish (D-058).
# The website VERIFIES this; it never calls PSM. Long random value, set in Vercel + PSM.
PSM_PUBLISH_SECRET=
