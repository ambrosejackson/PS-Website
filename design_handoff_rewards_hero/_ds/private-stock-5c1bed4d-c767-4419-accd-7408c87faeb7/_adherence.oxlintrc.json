{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": []
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|Lato))/i]",
        "message": "Font not provided by the design system. Available: Poppins, Lato."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-foreground",
      "--background",
      "--border",
      "--card",
      "--card-foreground",
      "--destructive",
      "--destructive-foreground",
      "--foreground",
      "--input",
      "--muted",
      "--muted-foreground",
      "--popover",
      "--popover-foreground",
      "--primary",
      "--primary-foreground",
      "--radius",
      "--ring",
      "--secondary",
      "--secondary-foreground",
      "--section-header-foreground",
      "--section-header-gradient",
      "--sidebar-accent",
      "--sidebar-accent-foreground",
      "--sidebar-background",
      "--sidebar-border",
      "--sidebar-foreground",
      "--sidebar-menu-item",
      "--sidebar-primary",
      "--sidebar-primary-foreground",
      "--sidebar-ring",
      "--tw-ring-color"
    ],
    "tokenKinds": {
      "--background": "color",
      "--foreground": "color",
      "--card": "color",
      "--card-foreground": "color",
      "--popover": "color",
      "--popover-foreground": "color",
      "--primary": "color",
      "--primary-foreground": "color",
      "--secondary": "color",
      "--secondary-foreground": "color",
      "--muted": "color",
      "--muted-foreground": "color",
      "--accent": "color",
      "--accent-foreground": "color",
      "--destructive": "color",
      "--destructive-foreground": "color",
      "--border": "color",
      "--input": "color",
      "--ring": "color",
      "--radius": "radius",
      "--sidebar-background": "color",
      "--sidebar-foreground": "color",
      "--sidebar-primary": "color",
      "--sidebar-primary-foreground": "color",
      "--sidebar-accent": "color",
      "--sidebar-accent-foreground": "color",
      "--sidebar-border": "color",
      "--sidebar-ring": "color",
      "--section-header-foreground": "color",
      "--section-header-gradient": "color",
      "--sidebar-menu-item": "color",
      "--tw-ring-color": "color"
    },
    "fontFamilies": [
      "Lato",
      "Poppins"
    ]
  }
}